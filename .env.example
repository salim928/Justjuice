# Password for the owner to sign in at /admin
ADMIN_PASSWORD=change-me

# Any long random string (>= 16 chars). Used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-at-least-16-chars

# ---- Persistent storage (required on Vercel / any read-only-FS host) ----
# Without these, the app reads/writes data/*.json on the local disk (fine for dev,
# fails on Vercel because /var/task is read-only).
#
# Free setup on Vercel:
#   1. Project → Storage → Create Database → "Upstash for Redis" (Marketplace)
#   2. Connect it to the project — Vercel auto-fills these two env vars.
#   3. Redeploy. On first read, the bundled data/products.json and
#      data/orders.json seed the Redis keys; after that Redis is the source
#      of truth and survives deploys.
#
# Or use any Upstash account directly (console.upstash.com → Redis → REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
